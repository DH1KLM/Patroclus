<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Patroclus;assembly=Patroclus.Avalonia" x:Class="Patroclus.Avalonia.Views.FakeHermesView">
  <StackPanel Spacing="10">
    <Border Classes="status">
      <WrapPanel Orientation="Horizontal" ItemWidth="Auto">
        <TextBlock Classes="section" Text="Bandwidth  "/><TextBlock Text="{Binding bandwidth}"/>
        <TextBlock Classes="section" Margin="18,0,0,0" Text="Status  "/><TextBlock Text="{Binding status}"/>
        <TextBlock Classes="section" Margin="18,0,0,0" Text="Seq. errors  "/><TextBlock Text="{Binding seqErrors}"/>
      </WrapPanel>
    </Border>
    <Border Classes="status">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="section" Text="TX1"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding txNCO, Converter={x:Static p:StringConverters.StringFormat},ConverterParameter=\{0:### ### ###\}}"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Classes="section" Text="Duplex"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding duplex}"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="section" Text="Clock error"/>
        <Slider Grid.Row="1" Grid.Column="1" Value="{Binding clockError, Mode=TwoWay}" Minimum="900" Maximum="1100" SmallChange="1" LargeChange="10" TickFrequency="10"/>
      </Grid>
    </Border>
    <TextBlock Classes="section" Text="Control bytes"/>
    <Border Classes="status" Padding="8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl Items="{Binding ccbits}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="4,1" Text="{Binding Converter={x:Static p:StringConverters.StringFormat},ConverterParameter=\{0:x8\}}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <TextBlock Classes="section" Text="Log"/>
    <TextBox IsReadOnly="True" Height="90" Text="{Binding log}" AcceptsReturn="True" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>