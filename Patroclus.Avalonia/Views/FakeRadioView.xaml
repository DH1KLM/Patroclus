<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:Patroclus.Avalonia.Views;assembly=Patroclus.Avalonia" xmlns:vm="clr-namespace:Patroclus.Avalonia.ViewModels;assembly=Patroclus.Avalonia" x:Class="Patroclus.Avalonia.Views.FakeRadioView">
  <Grid RowDefinitions="Auto,*">
    <Border Background="#F8FAFC" BorderBrush="#EAECF0" BorderThickness="0,0,0,1" Padding="12">
      <ContentControl Content="{Binding}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="{x:Type vm:FakeHermes}"><v:FakeHermesView/></DataTemplate>
          <DataTemplate DataType="{x:Type vm:FakeHermesNewProtocol}"><v:FakeHermesNewProtocolView/></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding receivers}" Margin="12" HorizontalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="8"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate><v:ReceiverView/></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>