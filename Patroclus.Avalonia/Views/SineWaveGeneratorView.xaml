<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Patroclus.Avalonia.Controls;assembly=Patroclus.Avalonia" x:Class="Patroclus.Avalonia.Views.SineWaveGeneratorView">
  <Border Background="#F8FAFC" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Padding="10">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Text="Amplitude" VerticalAlignment="Center"/>
      <Slider Grid.Column="1" Value="{Binding amplitude, Mode=TwoWay}" Minimum="-200" Maximum="0" SmallChange="1" LargeChange="10" TickFrequency="10"/>
      <TextBlock Grid.Column="2" Text="{Binding amplitude}" MinWidth="35" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="Freq Hz" VerticalAlignment="Center"/>
      <c:MultiSpinner Grid.Column="4" Maximum="99999999" Minimum="0" Value="{Binding frequency, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
    </Grid>
  </Border>
</UserControl>